# ─── Environment ─────────────────────────────────────────────────────
# dev | staging | prod — always use "dev" locally
EXPO_PUBLIC_APP_ENV=dev

# ─── Firebase ────────────────────────────────────────────────────────
# NOT set here. @react-native-firebase reads native config files, not env vars.
# Download from the Firebase console and place both at the repo root — they are
# gitignored:
#   google-services.json          (Android)
#   GoogleService-Info.plist      (iOS)

# ─── Google Maps ─────────────────────────────────────────────────────
# Use the surakshak-staging GCP key locally
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── OneSignal ───────────────────────────────────────────────────────
# Use the Surakshak Dev app ID locally
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# ─── MixPanel ────────────────────────────────────────────────────────
# Never initialises when APP_ENV=dev, but still required for env validation.
# Use the staging token.
EXPO_PUBLIC_MIXPANEL_TOKEN=

# ─── Sentry ──────────────────────────────────────────────────────────
# Never initialises when APP_ENV=dev, but still required for env validation.
# Use the staging DSN.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
