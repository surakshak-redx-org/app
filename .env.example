# ─── Environment ─────────────────────────────────────────────────────
# dev | staging | prod — always use "dev" locally
EXPO_PUBLIC_APP_ENV=dev

# ─── Firebase ────────────────────────────────────────────────────────
# NOT set here. @react-native-firebase reads native config files, not env vars.
# One pair per APP_ENV, chosen by bundle id in app.config.ts. For local dev
# (APP_ENV=dev, bundle com.surakshak.dev) download from the Firebase console and
# place at the repo root — all are gitignored:
#   google-services.dev.json          (Android)
#   GoogleService-Info.dev.plist      (iOS)
# The .staging.* / .prod.* pairs are only needed for local staging/prod builds.

# ─── Google Maps ─────────────────────────────────────────────────────
# Two keys, not one — a Maps key can only carry an Android OR an iOS app
# restriction, never both. Use the staging GCP keys locally.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=

# ─── OneSignal ───────────────────────────────────────────────────────
# Use the Surakshak Dev app ID locally
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# ─── MixPanel ────────────────────────────────────────────────────────
# Never initialises when APP_ENV=dev, but still required for env validation.
# Use the staging token.
EXPO_PUBLIC_MIXPANEL_TOKEN=

# ─── Sentry ──────────────────────────────────────────────────────────
# Never initialises when APP_ENV=dev, but still required for env validation.
# Use the staging DSN.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
