# ─────────────────────────────────────────────────────────────────────────────
# Surakshak Environment Configuration Template
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# IMPORTANT:
# - All variables prefixed with EXPO_PUBLIC_ are inlined by Expo at build time.
# - Validation is strictly enforced by src/config/env.ts using Zod on app startup.
# - DO NOT commit .env.local or real credentials to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Environment [REQUIRED] ──────────────────────────────────────────────────
# Allowed values: dev | staging | prod
# Always set to "dev" for local development (matches bundle id com.surakshak.dev).
EXPO_PUBLIC_APP_ENV=dev

# ─── Google Maps Platform [REQUIRED] ─────────────────────────────────────────
# Two separate API keys with platform-specific restrictions in Google Cloud:
# - Android: restricted to package name com.surakshak.dev & SHA-1 fingerprint
# - iOS: restricted to bundle ID com.surakshak.dev
# Both are required by the schema even if developing on one platform.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=

# ─── OneSignal Push Notifications [REQUIRED] ─────────────────────────────────
# OneSignal App ID (UUID format) for push notification delivery.
# Obtain from the team's OneSignal dev/staging dashboard.
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# ─── MixPanel Analytics [REQUIRED] ───────────────────────────────────────────
# Project token for Mixpanel. Note: Telemetry is automatically disabled when
# APP_ENV=dev (IS_TELEMETRY_ENABLED = false), but a non-empty string is required
# by the Zod startup validation.
EXPO_PUBLIC_MIXPANEL_TOKEN=

# ─── Sentry Error Monitoring [REQUIRED] ──────────────────────────────────────
# Sentry DSN. Note: Telemetry is automatically disabled when APP_ENV=dev,
# but the Zod schema requires a valid URL (z.url()). It MUST start with https://.
# Example format: https://examplePublicKey@o0.ingest.sentry.io/0
EXPO_PUBLIC_SENTRY_DSN=

# ─── Sentry CLI Auth Token [OPTIONAL] ────────────────────────────────────────
# Only needed for EAS/CI build machines uploading debug symbols and source maps.
# Can be left empty for local development.
SENTRY_AUTH_TOKEN=

# ─── Firebase Configuration (Native Files — NOT in .env) ─────────────────────
# @react-native-firebase reads native configuration files, not environment variables.
# For local development (APP_ENV=dev, bundle id com.surakshak.dev):
# - Android: place `google-services.dev.json` in the project root (or android/app/google-services.json)
# - iOS: place `GoogleService-Info.dev.plist` in the project root
# Both files are gitignored and never committed.
