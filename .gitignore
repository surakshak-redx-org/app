# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Yarn 4 (node-modules linker)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Test coverage
coverage/

# Surakshak — never commit these
.env
.env.local
.env.dev
.env.staging
.env.production
google-services*.json
GoogleService-Info*.plist

# Gradle & Android build artifacts (local native modules — /android itself is
# ignored above). Scoped to android/ so lockfiles like yarn.lock and
# Podfile.lock are never caught.
.gradle/
**/android/.gradle/
**/android/**/build/
**/android/**/*.lock
**/android/**/*.bin
*.dex
local.properties
**/local.properties

# IDEs and Editors
.idea/
*.iml
.vscode/

# Temporary / maintenance scripts
scripts/dedup-emergency-contacts.mjs

